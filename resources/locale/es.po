msgstr "Cambia la decisión o los roles de la figura para que coincidan."

msgid "Segment {segment} has figures active but none leading."
msgstr "El segmento {segment} tiene figuras activas, pero ninguna protagonista."

msgid "Choose a lead for that segment."
msgstr "Elige una protagonista para ese segmento."

msgid "The choreography was made from another composition plan."
msgstr "La coreografía se hizo a partir de otro plan de composición."

msgid "Make the choreography again from the current plan."
msgstr "Vuelve a hacer la coreografía a partir del plan actual."

msgid "The choreography event {event} is repeated or out of order, so two choreographies could not be compared."
msgstr "El evento {event} de la coreografía está repetido o desordenado, así que no se podrían comparar dos coreografías."

msgid "Make the choreography again; if it repeats, report the problem."
msgstr "Vuelve a hacer la coreografía; si se repite, informa del problema."

msgid "The choreography event {event} uses \"{model}\", which does not exist in this layout."
msgstr "El evento {event} de la coreografía usa «{model}», que no existe en este layout."

msgid "Make the choreography again for the current layout."
msgstr "Vuelve a hacer la coreografía para el layout actual."

msgid "The choreography event {event} lights \"{model}\", which was excluded from the show."
msgstr "El evento {event} de la coreografía enciende «{model}», que se excluyó del espectáculo."

msgid "Remove that event, or include the figure again in the roles file."
msgstr "Quita ese evento o vuelve a incluir la figura en el archivo de roles."

msgid "The choreography event {event} uses the template \"{template}\", which is not in the library or whose effect this xLights does not have."
msgstr "El evento {event} de la coreografía usa la plantilla «{template}», que no está en la biblioteca o cuyo efecto no existe en este xLights."

msgid "Choose an existing template."
msgstr "Elige una plantilla que exista."

msgid "The choreography event {event} uses \"{effect}\", but the template \"{template}\" is for \"{expected}\"."
msgstr "El evento {event} de la coreografía usa «{effect}», pero la plantilla «{template}» es para «{expected}»."

msgid "The template \"{template}\" cannot be used on \"{model}\" ({reason})."
msgstr "La plantilla «{template}» no se puede usar en «{model}» ({reason})."

msgid "Choose a template made for that kind of figure."
msgstr "Elige una plantilla hecha para ese tipo de figura."

msgid "Whether the template \"{template}\" works on \"{model}\" is only known once rendered."
msgstr "Si la plantilla «{template}» funciona en «{model}» solo se sabe al renderizar."

msgid "Check that part in the preview."
msgstr "Comprueba esa parte en la vista previa."

msgid "The choreography event {event} has an invalid setting {key}={value}: {reason}."
msgstr "El evento {event} de la coreografía tiene un ajuste no válido {key}={value}: {reason}."

msgid "Correct the template that produced it."
msgstr "Corrige la plantilla que lo generó."

msgid "The choreography event {event} has an invalid colour: {value}."
msgstr "El evento {event} de la coreografía tiene un color no válido: {value}."

msgid "Choose another palette."
msgstr "Elige otra paleta."

msgid "The choreography event {event} has invalid times or does not fall on the sequence's frames."
msgstr "El evento {event} de la coreografía tiene tiempos no válidos o no cae en los fotogramas de la secuencia."

msgid "Correct its start and end."
msgstr "Corrige su comienzo y su final."

msgid "The choreography event {event} lasts {length} ms, outside the {min}-{max} ms its template recommends."
msgstr "El evento {event} de la coreografía dura {length} ms, fuera de los {min}-{max} ms que recomienda su plantilla."

msgid "Check that it reads well at that length."
msgstr "Comprueba que se vea bien con esa duración."

msgid "The choreography event {event} overlaps {over} on the same figure and layer."
msgstr "El evento {event} de la coreografía se solapa con {over} en la misma figura y capa."

msgid "Move one of them to another layer or shorten it."
msgstr "Mueve uno de ellos a otra capa o acórtalo."

msgid "The choreography event {event} on \"{model}\" shares lights with \"{over}\" at the same time."
msgstr "El evento {event} de la coreografía sobre «{model}» comparte luces con «{over}» al mismo tiempo."

msgid "The choreography event {event} needs a {kind} file that does not exist."
msgstr "El evento {event} de la coreografía necesita un archivo de {kind} que no existe."

msgid "Add the file, or use the media cue instead of an effect."
msgstr "Añade el archivo o usa la sugerencia de medios en lugar de un efecto."

msgid "The choreography event {event} needs lyrics that are not there ({track})."
msgstr "El evento {event} de la coreografía necesita una letra que no está ({track})."

msgid "Synchronize the lyrics first."
msgstr "Sincroniza primero la letra."

msgid "A choreography event locked by hand on \"{model}\" ({event}) is no longer there."
msgstr "Un evento de coreografía bloqueado a mano sobre «{model}» ({event}) ya no está."

msgid "A manual choreography decision on \"{model}\" could not be applied ({reason}). The previous decision was kept."
msgstr "No se ha podido aplicar una decisión manual de coreografía sobre «{model}» ({reason}). Se ha conservado la decisión anterior."

msgid "Change the decision so that it suits the figure."
msgstr "Cambia la decisión para que se adapte a la figura."

