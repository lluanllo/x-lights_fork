msgstr "{count} eventos de la coreografía tienen limitaciones o incógnitas que solo se resuelven mirando la vista previa."

msgid "Review them in the preview."
msgstr "Revísalos en la vista previa."

msgid "{count} choreography events use templates nobody has reviewed visually yet."
msgstr "{count} eventos de la coreografía usan plantillas que nadie ha revisado visualmente todavía."

